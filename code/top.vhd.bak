-- top.vhd
--
-- Versão sem Nios II EDS / sem JTAG UART. Usa o "JTAG to Avalon Master
-- Bridge" (já disponível na instalação base do Quartus) conectado, DENTRO
-- do sistema Platform Designer, ao componente customizado capture_buffer.
--
-- Este arquivo assume que você gerou, via Platform Designer, um sistema
-- chamado "jtag_bridge_system" contendo:
--   - JTAG to Avalon Master Bridge
--   - capture_buffer (importado como componente customizado)
--   - conexão Avalon-MM entre os dois, feita DENTRO do Qsys
--   - clock e reset exportados
--   - as portas de conduit "data_in" e "data_valid" do capture_buffer
--     exportadas para fora do sistema (ver guia)
--
-- Assim como antes: confira o arquivo
-- jtag_bridge_system/synthesis/jtag_bridge_system_inst.vhd, gerado
-- automaticamente, para pegar os nomes REAIS das portas e ajustar o
-- component abaixo se necessário.

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity top is
	port(
		clk : in  std_logic  -- clock físico da placa (50 MHz na DE0-CV)
	);
end entity;

architecture rtl of top is

	signal reset : std_logic := '0';

	-- Sinal de entropia gerado pelo ringsManager
	signal trngBit : std_logic;

	-- Shift register que acumula 8 bits do TRNG em 1 byte
	signal shiftReg  : std_logic_vector(7 downto 0) := (others => '0');
	signal bitCount  : unsigned(2 downto 0) := (others => '0');
	signal byteValid : std_logic := '0';

	-- ATENÇÃO: ajuste este component com o que o Platform Designer gerou
	-- (confira jtag_bridge_system_inst.vhd após o Generate HDL).
	component jtag_bridge_system is
		port(
			clk_clk                : in  std_logic;
			reset_reset_n          : in  std_logic;
			capture_data_in        : in  std_logic_vector(7 downto 0);
			capture_data_valid     : in  std_logic
		);
	end component;

begin

	------------------------------------------------------------------
	-- Fonte de entropia (já existente)
	------------------------------------------------------------------
	rings_inst: entity work.ringsManager
		port map(
			clk    => clk,
			output => trngBit);

	------------------------------------------------------------------
	-- Acumula 8 bits do TRNG em 1 byte
	-- (Não há mais "busy" de UART: o capture_buffer descarta os bytes
	-- automaticamente quando não está em modo de captura, então este
	-- processo pode simplesmente rodar sempre)
	------------------------------------------------------------------
	process(clk)
	begin
		if rising_edge(clk) then
			byteValid <= '0';  -- pulso de 1 ciclo, default

			shiftReg <= shiftReg(6 downto 0) & trngBit;
			if bitCount = 7 then
				bitCount  <= (others => '0');
				byteValid <= '1';
			else
				bitCount <= bitCount + 1;
			end if;
		end if;
	end process;

	------------------------------------------------------------------
	-- Sistema gerado pelo Platform Designer
	-- (bridge JTAG-to-Avalon + capture_buffer, já conectados internamente)
	------------------------------------------------------------------
	bridge_sys_inst: component jtag_bridge_system
		port map(
			clk_clk             => clk,
			reset_reset_n       => not reset,  -- reset do sistema é ativo baixo
			capture_data_in     => shiftReg,
			capture_data_valid  => byteValid);

end architecture rtl;